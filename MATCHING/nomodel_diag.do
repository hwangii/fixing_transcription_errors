/*WHY DOES THE MODEL GIVE NO USABLE OUTPUT ON SOME TARGET RECORDS? (2026-11-21)*/
/*                                                                           */
/*Universe and definitions exactly as compute_model_agreement_on_discordant.do */
/*(HUMAN-COMPLETE): 1940 records in the 49 model states, all four human name */
/*fields non-empty, Ancestry and FamilySearch disagree on first or last name.*/
/*"No usable output" = namefrst_ml or namelast_ml_ditto empty. Split into   */
/*  1 both empty   2 first name empty only   3 surname (ditto-resolved) only */
/*and compared with 0 = model produced both names, on the fields the model   */
/*files carry: parsing_quality, namefrst_ml_prob, namelast_ml_prob,          */
/*non_ditto (human), non_ditto_ml and its prob, the raw surname namelast_ml  */
/*(before ditto resolution), and clustering by image (filename).           */
/*                                                                           */
/*CHECK: the universe and the no-output count reproduce                      */
/*replication/results/compute_model_agreement_on_discordant.tex              */
/*(nDiscordant 35,094,490; discNoModel raw 9.61909120206619).               */
/*READ-ONLY EXCEPT FOR MATCHING/results/nomodel_diag.md.                     */
/*  powershell -File replication/Run-Stata.ps1 MATCHING/nomodel_diag.do       */

clear all
set more off
if `"$REP_REPO"'=="" do "D:/repos/fixing_transcription_errors/replication/config.do"
local root "$REP_SNU/fixing_transcription_errors/DATA/TRANSCRIPTIONS/USCensus1940FullCount/output_and_output1_ssha2025"
local md   "$REP_REPO/MATCHING/results/nomodel_diag.md"
local states "al ar az ca co ct dc de fl ga ia id il in ks ky la ma md me mi mn mo ms mt nc nd ne nh nj nm nv ny oh ok or pa ri sc sd tn tx ut va vt wa wi wv wy"


local k 0
foreach s of local states {
	use filename linep parsing_quality non_ditto non_ditto_ml non_ditto_ml_prob namefrst fs_namefrst namefrst_ml namefrst_ml_prob namelast fs_namelast namelast_ml namelast_ml_ditto namelast_ml_prob using `"`root'/`s'/merged_data.dta"', clear
	keep if namefrst!="" & namelast!="" & fs_namefrst!="" & fs_namelast!="" & !(namefrst==fs_namefrst & namelast==fs_namelast)
	gen byte ftype = cond(namefrst_ml!="" & namelast_ml_ditto!="", 0, cond(namefrst_ml=="" & namelast_ml_ditto=="", 1, cond(namefrst_ml=="", 2, 3)))
	gen byte rawlast = namelast_ml!=""
	/*IMAGE CLUSTERING: SHARE OF THE *OTHER* TARGET RECORDS ON THIS IMAGE    */
	/*THAT FAIL (LEAVE-ONE-OUT, SO A RECORD'S OWN FAILURE DOES NOT COUNT;     */
	/*MISSING FOR A RECORD ALONE ON ITS IMAGE). EMPTY filename IS NOT AN      */
	/*IMAGE AND GETS MISSING (2026-11-21 REVIEW).                             */
	gen byte fail = ftype>0
	bysort filename: egen long img_nf = total(fail)
	bysort filename: gen long img_n = _N
	gen double img_fail = (img_nf - fail)/(img_n - 1) if img_n>1 & filename!=""
	replace img_n = . if filename==""
	drop img_nf
	gen str2 st = "`s'"
	keep st ftype fail rawlast img_fail img_n linep parsing_quality non_ditto non_ditto_ml non_ditto_ml_prob namefrst_ml_prob namelast_ml_prob
	compress
	local ++k
	tempfile p`k'
	save `p`k''
}
assert `k'==49
use `p1', clear
forvalues i = 2/`k' {
	append using `p`i''
}

/*CHECK AGAINST THE PAPER'S NUMBERS.*/
assert _N==35094490
quietly sum fail
assert abs(100*r(mean) - 9.61909120206619) < 1e-9

label define ft 0 "Both names" 1 "Both empty" 2 "First name empty" 3 "Surname empty"
label values ftype ft

capture file close md
file open md using `"`md'"', write replace text
file write md "# Target records without usable model output" _n _n
file write md "Generated by MATCHING/nomodel_diag.do. Do not edit by hand." _n _n
file write md "1940 target records (Ancestry and FamilySearch disagree, all four human name fields present), 49 model states: 35,094,490, as in compute_model_agreement_on_discordant.do. No usable output = model first name or ditto-resolved surname empty (9.62%). Probabilities are the model's own; missing values excluded from means. 'Raw surname present' = namelast_ml non-empty before ditto resolution. 'Image mostly failing' = more than half of the other target records on the same image lack usable output (the record itself excluded; records alone on an image or with no filename left out)." _n _n
file write md "| | Both names | Both empty | First name empty | Surname empty |" _n
file write md "|---|---:|---:|---:|---:|" _n

local r "| Records |"
forvalues t = 0/3 {
	quietly count if ftype==`t'
	local r "`r' `=strtrim(string(r(N), "%15.0fc"))' |"
}
file write md "`r'" _n
local r "| Share of target records (%) |"
forvalues t = 0/3 {
	quietly count if ftype==`t'
	local r "`r' `=strtrim(string(100*r(N)/_N, "%6.2f"))' |"
}
file write md "`r'" _n

foreach v in parsing_quality namefrst_ml_prob namelast_ml_prob non_ditto_ml_prob linep {
	foreach stat in mean p10 p50 p90 nmiss {
		local r "| `v' `stat' |"
		forvalues t = 0/3 {
			if "`stat'"=="nmiss" {
				quietly count if ftype==`t' & missing(`v')
				local x = r(N)
				local r "`r' `=strtrim(string(`x', "%15.0fc"))' |"
			}
			else {
				quietly summarize `v' if ftype==`t', detail
				local x = cond("`stat'"=="mean", r(mean), r(`stat'))
				local r "`r' `=strtrim(string(`x', "%9.3f"))' |"
			}
		}
		file write md "`r'" _n
	}
}

local r "| Raw surname present (%) |"
forvalues t = 0/3 {
	quietly sum rawlast if ftype==`t'
	local r "`r' `=strtrim(string(100*r(mean), "%6.1f"))' |"
}
file write md "`r'" _n
local r "| Image mostly failing (%) |"
forvalues t = 0/3 {
	quietly count if ftype==`t' & img_fail>0.5 & !missing(img_fail)
	local a = r(N)
	quietly count if ftype==`t' & !missing(img_fail)
	local r "`r' `=strtrim(string(100*`a'/r(N), "%6.1f"))' |"
}
file write md "`r'" _n
local r "| Records with an image share (leave-one-out defined) |"
forvalues t = 0/3 {
	quietly count if ftype==`t' & !missing(img_fail)
	local r "`r' `=strtrim(string(r(N), "%15.0fc"))' |"
}
file write md "`r'" _n
/*AVERAGED OVER RECORDS, NOT IMAGES (2026-11-21 REVIEW): THE SIZE OF THE   */
/*IMAGE A TYPICAL RECORD OF THIS TYPE SITS ON.                             */
local r "| Target records on the record's image (mean over records) |"
forvalues t = 0/3 {
	quietly sum img_n if ftype==`t'
	local r "`r' `=strtrim(string(r(mean), "%9.1f"))' |"
}
file write md "`r'" _n

/*DITTO FLAGS: HUMAN non_ditto AND MODEL non_ditto_ml, ALL VALUES.*/
foreach v in non_ditto non_ditto_ml {
	file write md _n "## `v' (share within column, %)" _n _n
	file write md "| value | Both names | Both empty | First name empty | Surname empty |" _n
	file write md "|---|---:|---:|---:|---:|" _n
	quietly levelsof `v', missing local(vals)
	if `: word count `vals''>20 {
		file write md "More than 20 distinct values; not tabulated." _n
		continue
	}
	foreach val of local vals {
		local r "| `val' |"
		forvalues t = 0/3 {
			quietly count if ftype==`t'
			local d = r(N)
			quietly count if ftype==`t' & `v'==`val'
			local r "`r' `=strtrim(string(100*r(N)/`d', "%6.1f"))' |"
		}
		file write md "`r'" _n
	}
}

/*BY STATE: FAILURE SHARE.*/
file write md _n "## Share without usable output by state (%)" _n _n
file write md "| state | target records | no usable output (%) |" _n
file write md "|---|---:|---:|" _n
foreach s of local states {
	quietly sum fail if st=="`s'"
	file write md "| `s' | `=strtrim(string(r(N), "%15.0fc"))' | `=strtrim(string(100*r(mean), "%6.1f"))' |" _n
}
file close md
display "wrote `md'"
