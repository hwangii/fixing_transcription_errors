. local f_intermediate "$REP_F/enum_date/DATA/INTERMEDIATE/"

. 
. foreach yr in 1930 1940 {
  2.         /*RAW AND OLD STORED ANCESTRY NAMES, BOTH SEXES                   
>      */
.         local src `"`f_intermediate'divided_file`yr'_women_added"'
  3.         local fl : dir `"`src'"' files "norace*.dta"
  4.         if `"`fl'"'=="" {
  5.                 display as error "no norace*.dta files in `src'"
  6.                 exit 601
  7.         }
  8.         local k 0
  9.         foreach f of local fl {
 10.                 local ++k
 11.                 use histid namefrst_ans namefrst_ans_cleaned using `"`src'
> /`f'"', clear
 12.                 tempfile r`k'
 13.                 save `r`k''
 14.         }
 15.         use `r1', clear
 16.         forvalues i = 2/`k' {
 17.                 append using `r`i''
 18.         }
 19.         isid histid
 20.         rename namefrst_ans_cleaned old_f
 21.         tempfile raw
 22.         save `raw'
 23. 
.         if `yr'==1940 use histid namefrst namefrst_true_cleaned using `"`f_in
> termediate'for_mlp1940_v26.dta"', clear
 24.         else          use histid namefrst using `"`f_intermediate'for_mlp1
> 930_v26.dta"', clear
 25.         merge 1:1 histid using `raw', assert(3) nogen
 26.         display _n "===== `yr': " %15.0fc _N " records"
 27. 
.         /*(1) NEW ANCESTRY "marshall"                                        
>   */
.         display "`yr' new Ancestry first name marshall: " _continue
 28.         count if namefrst=="marshall"
 29.         display "`yr' ... of which raw name lacks 'marsh': " _continue
 30.         count if namefrst=="marshall" & !strpos(lower(namefrst_ans),"marsh
> ")
 31.         preserve
 32.         keep if namefrst=="marshall"
 33.         contract namefrst_ans
 34.         gsort -_freq
 35.         list in 1/`=min(25,_N)', noobs
 36.         restore
 37. 
.         /*(2) NEW MODEL "marshall", 1940                                     
>   */
.         if `yr'==1940 {
 38.                 display "1940 new model first name marshall: " _continue
 39.                 count if namefrst_true_cleaned=="marshall"
 40.                 display "1940 ... of which raw Ancestry name lacks 'marsh'
> : " _continue
 41.                 count if namefrst_true_cleaned=="marshall" & !strpos(lower
> (namefrst_ans),"marsh")
 42.                 preserve
 43.                 keep if namefrst_true_cleaned=="marshall" & !strpos(lower(
> namefrst_ans),"marsh")
 44.                 if _N {
 45.                         contract namefrst_ans
 46.                         gsort -_freq
 47.                         list in 1/`=min(25,_N)', noobs
 48.                 }
 49.                 restore
 50.         }
 51. 
.         /*(3) OLD STORED "marshall" -> NEW                                   
>    */
.         display "`yr' old stored marshall: " _continue
 52.         count if old_f=="marshall"
 53.         display "`yr' old stored marshall, new still marshall: " _continue
 54.         count if old_f=="marshall" & namefrst=="marshall"
 55.         preserve
 56.         keep if old_f=="marshall"
 57.         contract namefrst
 58.         gsort -_freq
 59.         list in 1/`=min(25,_N)', noobs
 60.         restore
 61. }
