> S OWN */
.         /*paths.do READS $ROOT (DATA) AND $LCODE (CODE), SET HERE FROM THESE.
>      */
.         global REP_MACHINE "B"
.         global REP_REPO    "F:/github_repos/fixing_transcription_errors"
.         global REP_PAPER   "F:/github_repos/6638fa0fd89fbec05130caeb"
