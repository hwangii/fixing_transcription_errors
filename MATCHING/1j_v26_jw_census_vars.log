. local fi "$REP_F/enum_date/DATA/INTERMEDIATE/"

. local orig "$REP_SNU/enum_date/DATA/ORIGINAL/"

. foreach yr in 1930 1940 {
  2.         capture confirm file `"`fi'jw_census_vars`yr'_v26.dta"'
  3.         if !_rc {
  4.                 display as error "jw_census_vars`yr'_v26.dta exists; move 
> it aside first"
  5.                 exit 602
  6.         }
  7. }

. 
. foreach yr in 1930 1940 {
  2.         /*THE v26 MEN, WITH THE BIRTHPLACE OF THEIR SHARD                 
>        */
.         local d `"`fi'divided_file`yr'_v26_ans_cleaned"'
  3.         local fl : dir `"`d'"' files "norace*.dta"
  4.         if `"`fl'"'=="" {
  5.                 display as error "no shards in `d'"
  6.                 exit 601
  7.         }
  8.         clear
  9.         local k 0
 10.         foreach f of local fl {
 11.                 local b = subinstr(subinstr("`f'", "norace", "", 1), ".dta
> ", "", 1)
 12.                 confirm integer number `b'
 13.                 local ++k
 14.                 preserve
 15.                 use id age using `"`d'/`f'"', clear
 16.                 gen int sbpl = `b'
 17.                 tempfile s
 18.                 save `s'
 19.                 restore
 20.                 append using `s'
 21.         }
 22.         rename (id age) (histid sage)
 23.         isid histid
 24.         local N = _N
 25.         tempfile men
 26.         save `men'
 27. 
.         use histid bpl birthyr race sex age using `"`orig'matching_intgen`yr'
> _women_added.dta"', clear
 28.         /*ONE ROW PER histid IN THE SOURCE FOR THE MEN WE KEEP (CHECKED BE
> LOW).  */
.         merge m:1 histid using `men', keep(2 3)
 29.         local bad 0
 30.         quietly count if _merge==2
 31.         display "`yr': v26 men not in the source: " r(N)
 32.         local bad = `bad' + r(N)
 33.         keep if _merge==3
 34.         drop _merge
 35.         duplicates tag histid, gen(dup)
 36.         quietly count if dup
 37.         display "`yr': v26 men on more than one source row: " r(N)
 38.         local bad = `bad' + r(N)
 39.         drop dup
 40.         quietly count if bpl != sbpl
 41.         display "`yr': birthplace differs from the shard's: " r(N)
 42.         local bad = `bad' + r(N)
 43.         quietly count if age != sage
 44.         display "`yr': age differs from the shard's: " r(N)
 45.         local bad = `bad' + r(N)
 46.         quietly count if sex != 1
 47.         display "`yr': not sex 1: " r(N)
 48.         local bad = `bad' + r(N)
 49.         /*EVERY RACE: 0_create...:159 LIMITS ONLY THE LIST OF BIRTHPLACES 
> TO RACE  */
.         /*1|2, AND EACH BIRTHPLACE FILE IS RELOADED WITH ALL RACES (LINE 167)
> .    */
.         tab race, missing
 50.         quietly count if missing(race)
 51.         display "`yr': race missing: " r(N)
 52.         local bad = `bad' + r(N)
 53.         quietly count if missing(birthyr)
 54.         display "`yr': birthyr missing (reported, not an error): " r(N)
 55.         if `bad' {
 56.                 display as error "`yr': CHECK FAILED"
 57.                 exit 9
 58.         }
 59.         assert _N==`N'
 60.         keep histid bpl birthyr race sex
 61.         order histid bpl birthyr race sex
 62.         sort histid
 63.         compress
 64.         save `"`fi'jw_census_vars`yr'_v26.dta"'
 65.         display "`yr': `k' shards, `N' men written"
 66. }
