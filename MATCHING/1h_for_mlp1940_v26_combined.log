> leaned==namelast_true_cleaned & mi_tgt_cleaned==mi_true_cleaned & name_tgt_cl
> eaned_exists==name_true_cleaned_exists

. gen byte isold = namefrst_tgt_cleaned==namefrst & namelast_tgt_cleaned==namel
> ast & mi_tgt_cleaned==mi & name_tgt_cleaned_exists==0

. assert isnew | isold

. quietly count if name_tgt_cleaned_exists==1

