*! repnum 1.0  2026-10-15  write a number the paper quotes to a tracked .tex file
*! Part of the replication package -- see replication/README.md.
*!
*!   repnum open using "<file>.tex", script(CODE/<name>.do)
*!   repnum <Key> = <exp> [, format(%fmt)]
*!   repnum close
*!
*! Each number becomes one line,
*!   \newcommand{\Key}{<exp formatted with fmt>}% raw=<exp at full precision>
*! so the draft can \input the file and use \Key, and check_claims.py can
*! compare the raw value with what the draft says. Keys must be letters only,
*! because LaTeX command names cannot contain digits or underscores.
*!
*! A missing value is an error, not a line: a "." reaching the paper is exactly
*! the silent failure this package exists to stop.

program define repnum
	version 15.1
	gettoken sub 0 : 0

	if `"`sub'"' == "open" {
		syntax using/, SCRIPT(string)
		global REPNUM_FILE `"`using'"'
		tempname h
		file open `h' using `"`using'"', write replace text
		file write `h' "% GENERATED BY `script' -- DO NOT EDIT BY HAND." _n
		file write `h' "% One number per line; raw= is the unrounded value." _n
		file write `h' "% replication/check_claims.py compares raw= with the draft." _n
		file close `h'
		exit
	}

	if `"`sub'"' == "close" {
		global REPNUM_FILE
		exit
	}

	local key `"`sub'"'
	if !ustrregexm(`"`key'"', "^[A-Za-z]+$") {
		display as error `"repnum: key "`key'" must be letters only (it becomes a LaTeX command)"'
		exit 198
	}
	if `"$REPNUM_FILE"' == "" {
		display as error "repnum: no results file open -- call repnum open first"
		exit 198
	}

	syntax =/exp [, Format(string)]
	if `"`format'"' == "" local format "%21.15g"

	tempname s h
	scalar `s' = `exp'
	if missing(`s') {
		display as error "repnum: `key' is missing -- refusing to write it"
		exit 504
	}

	local raw  = trim(string(`s', "%21.15g"))
	local disp = trim(string(`s', `"`format'"'))

	/*_char(92) IS THE BACKSLASH. WRITING IT AS A LITERAL NEXT TO A MACRO   */
	/*REFERENCE WOULD BE READ AS \` -- "DO NOT EXPAND" -- AND SILENTLY BREAK.*/
	file open `h' using `"$REPNUM_FILE"', write append text
	file write `h' _char(92) "newcommand{" _char(92) "`key'}{`disp'}% raw=`raw'" _n
	file close `h'

	display as text "repnum: " as result "`key'" as text " = `disp'  (raw `raw')"
end
