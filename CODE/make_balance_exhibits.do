/*****************************************************************************/
/*REGENERATE balance_allstates.tex AND incongruent_allstates.tex EXPLICITLY. */
/*                                                                           */
/*THESE TWO EXHIBITS WERE PRODUCED BY balancetable IN munir_figures_for_nber */
/*.do. THAT WORKED, BUT LEFT TWO ARTIFACTS THAT THE claims-vs-code REVIEWS   */
/*FLAGGED AND THAT NO balancetable OPTION FIXES:                             */
/*                                                                           */
/*  1. THE "Diff." COLUMN'S OBSERVATION COUNT WAS 55,350,482 -- THE WHOLE    */
/*     MALE 10+ POPULATION, WHICH IS NEITHER OF THE TWO COMPARED GROUPS NOR  */
/*     THEIR SUM (51,066,203). IT IS THE DATASET'S _N, NOT THE REGRESSION'S. */
/*  2. THE BALANCE TABLE CARRIED AN "Incongruent transcription" ROW SHOWING  */
/*     0.283 IN BOTH COLUMNS. CONGRUENCY IS UNDEFINED OUTSIDE THE ANALYSIS   */
/*     SAMPLE, SO STATA AVERAGED THE SAME RECORDS TWICE: THE TWO ENTRIES WERE*/
/*     IDENTICAL BY CONSTRUCTION AND THE COMPARISON WAS VACUOUS.             */
/*                                                                           */
/*WRITING THE LaTeX DIRECTLY FIXES BOTH AND FOLLOWS THE PRECEDENT ALREADY SET*/
/*BY avg_performance_allstates.tex IN create_figures_SSHA2025.do. THE COLUMN */
/*STRUCTURE, VARIABLE ORDER, LABELS AND NUMBER FORMATS ARE UNCHANGED, SO THE */
/*REGENERATED TABLES REMAIN COMPARABLE TO THE COMMITTED ONES.                */
/*                                                                           */
/*AGE CUTOFF IS 10, AS IN THE PAPER'S OWN ANALYSIS. DEAGLAN'S ROBUSTNESS     */
/*TABLES USE 8; THEY DESCRIBE A DIFFERENT EXERCISE AND ARE NOT HARMONISED    */
/*HERE ON PURPOSE -- SEE THE NOTE AT THE END OF THIS FILE.                   */

clear all
set more off

/*REPLICATION PACKAGE: THE NUMBERS THE DRAFT QUOTES ARE WRITTEN BY repnum  */
/*TO THE FILE BELOW, NOT ONLY DISPLAYED. SEE replication/README.md.         */
if `"$REP_REPO"'=="" do "D:/repos/fixing_transcription_errors/replication/config.do"
repnum open using "$REP_RESULTS/make_balance_exhibits.tex", script(CODE/make_balance_exhibits.do)

local dropbox "D:\SNU ECON Dropbox\sam hwang\"
local overleaf "D:\repos\6638fa0fd89fbec05130caeb\"
local trans_intermediate_f "F:\fixing_transcription_errors\DATA\INTERMEDIATE\"
local figure "`overleaf'figures\"

/*THE 18 CHARACTERISTICS, IN THE ORDER THE COMMITTED TABLES USE.*/
local chars "black american_indian asian northeast_bpl midwest_bpl south_bpl west_bpl foreign_born father_foreign_born urban farm no_ed grad_elem white_color skilled unskilled farmer incwage"

use `"`trans_intermediate_f'temp.dta"', clear

capture label var white_color "White-collar occupation"
capture label var skilled "Skilled occupation"
capture label var unskilled "Unskilled occupation"

keep if age>=10 & female==0

/*FAIL LOUDLY RATHER THAN WRITING A TABLE WITH SILENTLY MISSING ROWS.*/
foreach v in incongruent `chars' {
	capture confirm variable `v'
	if _rc {
		display as error "MISSING VARIABLE: `v' -- no table written"
		exit 111
	}
}

gen byte in_analysis_sample = incongruent!=.

quietly count
local n_us = r(N)
quietly count if in_analysis_sample==1
local n_as = r(N)
quietly count if incongruent==0
local n_cong = r(N)
quietly count if incongruent==1
local n_inc = r(N)

display "males 10+            : `n_us'"
display "analysis sample      : `n_as'"
display "  congruent          : `n_cong'"
display "  incongruent        : `n_inc'"

/*THE TWO GROUPS MUST EXHAUST THE ANALYSIS SAMPLE. IF THEY DO NOT, THE       */
/*OBSERVATION ROW OF THE SECOND TABLE WOULD BE WRONG IN THE SAME WAY THE OLD */
/*ONE WAS, SO STOP INSTEAD.                                                  */
if `n_cong'+`n_inc' != `n_as' {
	display as error "PARTITION FAILED: `n_cong'+`n_inc' != `n_as'"
	exit 459
}

/*=========================== TABLE 1: BALANCE ==============================*/
/*US (ALL MALES 10+) VERSUS THE ANALYSIS SAMPLE. incongruent IS DELIBERATELY */
/*NOT A ROW HERE: IT IS UNDEFINED FOR EVERY RECORD OUTSIDE COLUMN 2, SO THE  */
/*COMPARISON CANNOT BE MADE. THE RATE IS REPORTED IN THE TEXT INSTEAD.       */
capture file close bal
file open bal using `"`figure'balance_allstates.tex"', write replace text

file write bal "%GENERATED BY CODE/make_balance_exhibits.do -- DO NOT EDIT BY HAND." _n
file write bal "\begin{tabular}{l*{2}c}" _n
file write bal "\hline\hline" _n
file write bal " & US & Analysis sample \\" _n
file write bal "\hline" _n

foreach v of local chars {
	local lbl : variable label `v'
	if `"`lbl'"'=="" local lbl "`v'"

	quietly summarize `v'
	local m_us = r(mean)
	quietly summarize `v' if in_analysis_sample==1
	local m_as = r(mean)

	/*incwage IS A LEVEL IN DOLLARS; EVERYTHING ELSE IS A SHARE.*/
	if "`v'"=="incwage" {
		local s_us = trim(string(`m_us',"%12.3fc"))
		local s_as = trim(string(`m_as',"%12.3fc"))
	}
	else {
		local s_us = trim(string(`m_us',"%4.3f"))
		local s_as = trim(string(`m_as',"%4.3f"))
	}

	/*THE TWO ROWS THE PROSE QUOTES, IN PERCENT.*/
	if inlist("`v'","urban","farm") {
		local K = proper("`v'")
		repnum share`K'US     = 100*`m_us', format(%4.1f)
		repnum share`K'Sample = 100*`m_as', format(%4.1f)
	}

	file write bal "`lbl'&`s_us'&`s_as'\\" _n
}

file write bal "\hline" _n
file write bal "Observations & " (trim(string(`n_us',"%15.0fc"))) " & " (trim(string(`n_as',"%15.0fc"))) " \\" _n
file write bal "\hline\hline" _n
file write bal "\end{tabular}" _n
file close bal

display "WROTE balance_allstates.tex"

/*====================== TABLE 2: CONGRUENT VS INCONGRUENT ==================*/
/*THE OBSERVATION ROW NOW REPORTS THE TWO GROUPS AND, UNDER "Diff.", THE     */
/*SAMPLE THE DIFFERENCE IS ACTUALLY COMPUTED ON -- THEIR SUM.                */
capture file close inc
file open inc using `"`figure'incongruent_allstates.tex"', write replace text

file write inc "%GENERATED BY CODE/make_balance_exhibits.do -- DO NOT EDIT BY HAND." _n
file write inc "\begin{tabular}{l*{3}c}" _n
file write inc "\hline\hline" _n
file write inc " & \multicolumn{2}{c}{Transcription} & \multicolumn{1}{c}{\multirow{2}{*}{Diff.}}\\ \cline{2-3}" _n
file write inc " & Congruent & Incongruent &  \\" _n
file write inc "\hline" _n

foreach v of local chars {
	local lbl : variable label `v'
	if `"`lbl'"'=="" local lbl "`v'"

	quietly summarize `v' if incongruent==0
	local m0 = r(mean)
	quietly summarize `v' if incongruent==1
	local m1 = r(mean)

	/*DIFFERENCE AND ITS p-VALUE FROM A REGRESSION ON THE GROUP INDICATOR,   */
	/*WHICH IS WHAT balancetable REPORTED, SO THE COLUMN IS UNCHANGED.       */
	quietly regress `v' incongruent
	local d  = _b[incongruent]
	local se = _se[incongruent]
	local p  = 2*ttail(e(df_r), abs(`d'/`se'))

	local star ""
	if `p' < 0.10 local star "*"
	if `p' < 0.05 local star "**"
	if `p' < 0.01 local star "***"

	if "`v'"=="incwage" {
		local s0 = trim(string(`m0',"%12.3fc"))
		local s1 = trim(string(`m1',"%12.3fc"))
		local sd = trim(string(`d', "%12.3fc"))
	}
	else {
		local s0 = trim(string(`m0',"%4.3f"))
		local s1 = trim(string(`m1',"%4.3f"))
		local sd = trim(string(`d', "%4.3f"))
	}

	file write inc "`lbl'&`s0'&`s1'&`sd'`star'\\" _n
}

file write inc "\hline" _n
file write inc "Observations & " (trim(string(`n_cong',"%15.0fc"))) " & " (trim(string(`n_inc',"%15.0fc"))) " & " (trim(string(`n_as',"%15.0fc"))) " \\" _n
file write inc "\hline\hline" _n
file write inc "\end{tabular}" _n
file close inc

display "WROTE incongruent_allstates.tex"

display ""
display "=================== SUMMARY ==================="
display "males 10+ (US column)      : `n_us'"
display "analysis sample            : `n_as'"
display "congruent / incongruent    : `n_cong' / `n_inc'"
quietly summarize incongruent
display "incongruent share          : " %5.4f r(mean)
display "==============================================="

repnum nMalesTen    = `n_us',   format(%15.0fc)
repnum nAnalysis    = `n_as',   format(%15.0fc)
repnum nCongruent   = `n_cong', format(%15.0fc)
repnum nIncongruent = `n_inc',  format(%15.0fc)
repnum pctIncongruent = 100*`n_inc'/`n_as', format(%4.1f)
repnum pctCongruent   = 100*`n_cong'/`n_as', format(%4.1f)
repnum close

/*ON THE AGE CUTOFF. THESE TABLES USE age>=10, WHICH IS THE PAPER'S OWN      */
/*ANALYSIS SAMPLE AND MATCHES avg_performance_allstates.tex. DEAGLAN'S       */
/*LINKAGE TABLES USE age>=8 BECAUSE HIS SCRIPTS DO, AND THEY DESCRIBE A      */
/*SEPARATE ROBUSTNESS EXERCISE ON A DIFFERENT UNIVERSE (ONE OF THEM INCLUDES */
/*WOMEN). HARMONISING WOULD MEAN CHANGING THE PAPER'S MAIN ANALYSIS TO MATCH */
/*A ROBUSTNESS CHECK, WHICH IS THE WRONG DIRECTION; THE DRAFT STATES EACH    */
/*TABLE'S CUTOFF INSTEAD.                                                    */
