  "required": ["summary", "dimensions_reviewed", "findings", "verified_clean", "review_limits"],
  "properties": {
    "summary": {
      "type": "string",
      "description": "Two to four sentences. The overall state of the reviewed work and the single most important thing to fix. No preamble."
    },
    "dimensions_reviewed": {
      "type": "array",
      "description": "Which scope dimensions were actually reviewed in this run.",
      "items": {
        "type": "string",
        "enum": ["correctness", "claims-vs-code", "replication", "identification"]
      }
    },
    "findings": {
      "type": "array",
      "description": "Defects and concerns, ordered most severe first. Empty if none. Do not pad with stylistic observations.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "dimension", "severity", "confidence", "title", "location", "what_the_code_does", "why_it_matters", "how_to_check", "suggested_fix"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable short slug, kebab-case, e.g. 'empty-string-agreement-inflation'."
          },
          "dimension": {
            "type": "string",
            "enum": ["correctness", "claims-vs-code", "replication", "identification"]
          },
          "severity": {
            "type": "string",
            "enum": ["blocker", "major", "minor", "nit"],
            "description": "blocker: a reported result is wrong. major: a referee would demand it. minor: real but survivable. nit: cosmetic."
          },
          "confidence": {
            "type": "string",
            "enum": ["verified", "likely", "speculative"],
            "description": "verified: traced in the source. likely: strongly implied but depends on unseen data. speculative: a question, not an established defect."
          },
          "title": {
            "type": "string",
            "description": "One line, stating the defect itself, not its category."
          },
          "location": {
            "type": "string",
            "description": "path:line, or path:line-line. Several may be comma-separated. Required: a finding without a location is not a finding."
          },
          "what_the_code_does": {
            "type": "string",
            "description": "Precisely what the code computes, quoting the relevant expression. Contrast with what it was evidently intended to compute."
          },
          "why_it_matters": {
            "type": "string",
            "description": "The consequence for a number or claim in the paper. If there is no consequence, the severity is nit."
          },
          "how_to_check": {
            "type": "string",
            "description": "A concrete command, tabulation, or count the author can run to confirm or refute this in minutes."
          },
          "suggested_fix": {
            "type": "string",
            "description": "The change, specific enough to act on. Do not apply it yourself."
          }
        }
      }
    },
    "verified_clean": {
      "type": "array",
      "description": "Things explicitly checked that were fine. This is what makes a short findings list trustworthy rather than lazy.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "evidence"],
        "properties": {
          "item": { "type": "string", "description": "What was checked." },
          "evidence": { "type": "string", "description": "How it was confirmed, with path:line where applicable." }
        }
      }
    },
    "review_limits": {
      "type": "array",
      "description": "What this review could NOT establish: data not readable, pipeline not runnable, paper text unavailable, Stata semantics not verifiable by reading. Be explicit; silence here reads as false assurance.",
      "items": { "type": "string" }
    }
  }
}
