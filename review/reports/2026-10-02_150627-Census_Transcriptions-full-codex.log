F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:26:* Denominator: BUNMD men with byear <= 1940
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:27:* 04_post_match.do leaves this in data/mortality/temp.dta;
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:28:* rebuild from the BUNMD csv if absent
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:29:*****************************************
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:30:
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:31:capture confirm file "$D_MORT/temp.dta"
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:32:if _rc == 0 {
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:33:	use "$D_MORT/temp.dta", clear
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:34:}
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:35:else {
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:36:	import delimited using "$bunmd_raw", clear varnames(1)
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:37:	keep ssn byear sex
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:38:	keep if sex == 1 & byear <= 1940
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:39:}
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:40:
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:41:qui count
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:42:global denom = r(N)
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:43:di "Denominator: $denom"
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:44:
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:45:*****************************************
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:46:* Counts from each of the four final matched files
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:47:*****************************************
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:48:
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:49:foreach spec in oldnames oldnames_conservative newnames newnames_conservative {
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:50:
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:51:	if strpos("`spec'", "old") > 0 {
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:52:		local mi "mi_old_A"
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:53:	}
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:54:	else {
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:55:		local mi "mi_new_A"
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:56:	}
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:57:
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:58:	use timediff_A timediff_B `mi' mname_B using ///
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:59:		"$output_dir/censoc_bunmd_matched_`spec'.dta", clear
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:60:	drop if missing(timediff_A) | missing(timediff_B)
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:61:
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:62:	* linked records
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:63:	qui count
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:64:	global n_`spec' = r(N)
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:65:
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:66:	* subset with a middle initial recorded in both sources
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:67:	qui keep if `mi' != "" & mname_B != ""
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:68:	qui count
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:69:	global v_`spec' = r(N)
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:70:
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:71:	* of those, the ones whose initials agree
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:72:	qui keep if lower(`mi') == lower(mname_B)
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:73:	qui count
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:74:	global a_`spec' = r(N)
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:75:
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:76:	di "`spec': N=${n_`spec'} validated=${v_`spec'} agree=${a_`spec'}"
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:77:}
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:78:
