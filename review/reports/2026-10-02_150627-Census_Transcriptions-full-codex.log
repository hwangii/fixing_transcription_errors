* now inside the package and reached through $ABE_SRC (see code/shared/paths.do).
use serial namelast_ans namefrst_ans birthyr bpl sex histid age race using "$ABE_SRC/matching_intgen1940", clear
merge 1:1 histid using  "$D_CENSUS/marriage_status_1940.dta"

keep if _merge == 3
drop _merge
save "$D_CENSUS/1940_census_for_merge_with_bunmd", replace
* NOTE: You need to set the Stata working directory to the path
* where the data file is located.

cd "$D_CENSUS"

set more off

clear
quietly infix                 ///
  int     year         1-4    ///
  long    sample       5-10   ///
  double  serial       11-18  ///
  double  hhwt         19-28  ///
  byte    gq           29-29  ///
  int     pernum       30-33  ///
  double  perwt        34-43  ///
  byte    marst        44-44  ///
  byte    versionhist  45-46  ///
  str     histid       47-82  ///
  using `"usa_00015.dat"'

replace hhwt        = hhwt        / 100
replace perwt       = perwt       / 100

format serial      %8.0f
format hhwt        %10.2f
format perwt       %10.2f

label var year        `"Census year"'
label var sample      `"IPUMS sample identifier"'
label var serial      `"Household serial number"'
label var hhwt        `"Household weight"'
label var gq          `"Group quarters status"'
label var pernum      `"Person number in sample unit"'
label var perwt       `"Person weight"'
label var marst       `"Marital status"'
label var versionhist `"Release version for historical full counts"'
label var histid      `"Consistent historical data person identifier"'

label define year_lbl 1850 `"1850"'
label define year_lbl 1860 `"1860"', add
label define year_lbl 1870 `"1870"', add
label define year_lbl 1880 `"1880"', add
