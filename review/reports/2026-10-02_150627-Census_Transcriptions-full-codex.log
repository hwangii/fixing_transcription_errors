350:    local namedir "$D_NAMES"
351:    local name30  "clean_names_1930_old.dta"
352:    local name40  "clean_names_1940_new.dta"
353:    local tag     "true_cleaned"
354:}
355:
356:local outdir "$ABEJW/data/matched_abe_`vint'"
357:capture mkdir "`outdir'"
358:
359:* ---- bpl values to process, with their sizes for a records-weighted ETA ----
360:capture confirm file "`bpldir'/bpl_list.dta"
361:if _rc {
362:    di as error "no bpl_list.dta in `bpldir'"
363:    exit 601
364:}
365:use "`bpldir'/bpl_list.dta", clear
366:
367:if "`bpl_subset'" != "" {
368:    generate byte _want = 0
369:    foreach b of local bpl_subset {
370:        quietly replace _want = 1 if bpl == `b'
371:    }
372:    quietly keep if _want == 1
373:    drop _want
374:    if _N == 0 {
