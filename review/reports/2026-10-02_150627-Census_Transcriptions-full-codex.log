F:/Deaglan/Census_Transcriptions/code/01_abe_jw/linkage/diagnose_abe_shortfall_step3.do:53:quietly generate byte blank_f = (trim(f_name_A) == "" | trim(f_name_B) == "")
F:/Deaglan/Census_Transcriptions/code/01_abe_jw/linkage/diagnose_abe_shortfall_step3.do:54:quietly generate byte blank_l = (trim(l_name_A) == "" | trim(l_name_B) == "")
