215:* True pairs: restricted to 1940 men
216:use `true_links', clear
217:keep histid1930 histid1940
218:duplicates drop histid1930 histid1940, force
219:rename histid1940 histid
220:merge m:1 histid using `men1940', keep(3) nogenerate
221:rename histid histid1940
222:tempfile true_pairs_full
223:save `true_pairs_full'
224:
225:* True pairs: further restricted to 1940 congruent == 0
226:use `true_pairs_full', clear
227:rename histid1940 histid
228:merge m:1 histid using `restr1940', keep(3) nogenerate
229:rename histid histid1940
230:tempfile true_pairs_restr
231:save `true_pairs_restr'
232:
233:* Person-level true links (histid1940 -> true_histid1930)
234:* Single file — classification does not depend on congruence
235:use `true_pairs_full', clear
236:rename histid1930 true_histid1930
237:tempfile true_by1940
238:save `true_by1940'
239:
240:
241:* ============================================================
242:* OUTER LOOP: run all analyses for full and restricted samples
243:* ============================================================
244:
245:foreach samp in full restr {
246:
247:    di _newline _newline "============================================================"
248:    di "METHOD: `mlabel'"
249:    if "`samp'" == "full"  di "SAMPLE: FULL"
250:    if "`samp'" == "restr" di "SAMPLE: RESTRICTED (congruent == 0)"
251:    di "============================================================"
252:
253:    * ============================================================
254:    * PART 1: LINKAGE RATES
255:    * ============================================================
256:
257:    di _newline "===== LINKAGE RATES ====="
258:
259:    foreach ver in old new {
260:
261:        prep_links "`link_`ver''" "`id1930'" "`id1940'" "`keepif'"
262:
263:        * If restricted, keep only pairs where histid1940 is in restricted set
264:        if "`samp'" == "restr" {
265:            rename histid1940 histid
266:            merge m:1 histid using `restr1940', keep(3) nogenerate
267:            rename histid histid1940
268:        }
269:
270:        scalar N_linked_`samp'_`ver' = _N
271:        scalar rate_`samp'_`ver'     = N_linked_`samp'_`ver' / N_men_1940_`samp'
272:
273:        di "`mtag'_`ver': " N_linked_`samp'_`ver' " pairs linked" ///
274:           "  |  rate = " %6.4f rate_`samp'_`ver'
275:    }
276:
277:
278:    * ============================================================
279:    * PART 2: PAIR-LEVEL COMPARISON TO TRUE LINKS
280:    * ============================================================
281:
282:    di _newline "===== LINK QUALITY (THREE CATEGORIES) ====="
283:
284:    foreach ver in old new {
285:
286:        prep_links "`link_`ver''" "`id1930'" "`id1940'" "`keepif'"
287:
288:        if "`samp'" == "restr" {
289:            rename histid1940 histid
290:            merge m:1 histid using `restr1940', keep(3) nogenerate
291:            rename histid histid1940
292:        }
293:
294:        * Classify matched pairs (1940-centric)
295:        merge m:1 histid1940 using `true_by1940', keep(1 3) gen(person_merge)
296:
297:        count if person_merge == 1
298:        scalar unverifiable_`samp'_`ver' = r(N)
299:        count if person_merge == 3 & histid1930 == true_histid1930
300:        scalar verified_`samp'_`ver' = r(N)
301:        count if person_merge == 3 & histid1930 != true_histid1930
302:        scalar contradicted_`samp'_`ver' = r(N)
303:
304:        * Recall: FN = true pairs not recovered
305:        preserve
306:            keep histid1930 histid1940
307:            merge 1:1 histid1930 histid1940 using `true_pairs_`samp'', keep(1 2 3) gen(pair_merge)
308:            count if pair_merge == 2
309:            scalar FN_`samp'_`ver' = r(N)
310:        restore
311:
312:        scalar recall_`samp'_`ver' = verified_`samp'_`ver' / ///
313:            (verified_`samp'_`ver' + FN_`samp'_`ver')
314:
315:        * Middle initial match rate
316:        preserve
317:            keep histid1930 histid1940
318:            rename histid1930 histid
319:            merge m:1 histid using `cn1930', keep(1 3) nogenerate
320:            rename histid histid1930
321:            rename mi mi1930
322:            rename histid1940 histid
323:            merge m:1 histid using `cn1940_`samp'', keep(1 3) nogenerate
324:            rename histid histid1940
325:            rename mi mi1940
326:            keep if mi1930 != "" & mi1940 != ""
327:            count
328:            scalar mi_denom_`samp'_`ver' = r(N)
329:            count if mi1930 == mi1940
330:            scalar mi_match_`samp'_`ver' = r(N)
331:            scalar mi_rate_`samp'_`ver'  = mi_match_`samp'_`ver' / mi_denom_`samp'_`ver'
332:        restore
333:
334:        di "`mtag'_`ver':" ///
335:           "  Verified=" verified_`samp'_`ver' ///
336:           "  Unverifiable=" unverifiable_`samp'_`ver' ///
337:           "  Contradicted=" contradicted_`samp'_`ver' ///
338:           "  Recall=" %5.3f recall_`samp'_`ver' ///
339:           "  MI match rate=" %5.3f mi_rate_`samp'_`ver'
340:    }
341:
342:
343:    * ============================================================
344:    * PART 3: NEW vs OLD — net added, net removed, changed links
345:    * ============================================================
346:
347:    di _newline "===== NEW vs OLD TRANSCRIPTION: PAIR CHANGES ====="
348:
349:    * ---- Load new transcription pairs ----
350:    prep_links "`link_new'" "`id1930'" "`id1940'" "`keepif'"
351:    if "`samp'" == "restr" {
352:        rename histid1940 histid
353:        merge m:1 histid using `restr1940', keep(3) nogenerate
354:        rename histid histid1940
355:    }
356:    duplicates drop histid1930, force
357:    rename histid1940 histid1940_new
358:    tempfile newlinks_`samp'
359:    save `newlinks_`samp''
360:
361:    * ---- Load old transcription pairs ----
362:    prep_links "`link_old'" "`id1930'" "`id1940'" "`keepif'"
363:    if "`samp'" == "restr" {
364:        rename histid1940 histid
365:        merge m:1 histid using `restr1940', keep(3) nogenerate
366:        rename histid histid1940
367:    }
368:    duplicates drop histid1930, force
369:    rename histid1940 histid1940_old
370:
371:    * ---- Merge on histid1930 ----
372:    merge 1:1 histid1930 using `newlinks_`samp'', gen(id_merge)
373:
374:    gen status = ""
375:    replace status = "net_removed" if id_merge == 1
376:    replace status = "net_added"   if id_merge == 2
377:    replace status = "unchanged"   if id_merge == 3 & histid1940_old == histid1940_new
378:    replace status = "changed"     if id_merge == 3 & histid1940_old != histid1940_new
379:
380:    * ---- Merge with true links (1940-centric) ----
381:    * For net_added/unchanged/changed: classify using histid1940_new
382:    * For net_removed: classify using histid1940_old
383:    * We need to merge twice — once per 1940 ID column
384:
385:    * Classify new link (net_added, changed)
386:    gen new_cat = .
387:    rename histid1940_new histid1940
388:    merge m:1 histid1940 using `true_by1940', keep(1 3) gen(merge_new)
389:    replace new_cat = 2 if inlist(status,"net_added","changed") & merge_new == 1
390:    replace new_cat = 1 if inlist(status,"net_added","changed") & merge_new == 3 & histid1930 == true_histid1930
391:    replace new_cat = 3 if inlist(status,"net_added","changed") & merge_new == 3 & histid1930 != true_histid1930
392:    rename histid1940 histid1940_new
393:    drop true_histid1930 merge_new
394:
395:    * Classify old link (net_removed, changed)
396:    gen old_cat = .
397:    rename histid1940_old histid1940
398:    merge m:1 histid1940 using `true_by1940', keep(1 3) gen(merge_old)
399:    replace old_cat = 2 if inlist(status,"net_removed","changed") & merge_old == 1
400:    replace old_cat = 1 if inlist(status,"net_removed","changed") & merge_old == 3 & histid1930 == true_histid1930
401:    replace old_cat = 3 if inlist(status,"net_removed","changed") & merge_old == 3 & histid1930 != true_histid1930
402:    rename histid1940 histid1940_old
403:    drop true_histid1930 merge_old
404:
405:    * ---- NET ADDED ----
406:    count if status == "net_added"
407:    scalar added_total_`samp' = r(N)
408:    count if status == "net_added" & new_cat == 1
409:    scalar added_verified_`samp' = r(N)
410:    count if status == "net_added" & new_cat == 2
411:    scalar added_unverifiable_`samp' = r(N)
412:    count if status == "net_added" & new_cat == 3
413:    scalar added_contradicted_`samp' = r(N)
414:
415:    * ---- NET REMOVED ----
416:    count if status == "net_removed"
417:    scalar removed_total_`samp' = r(N)
418:    count if status == "net_removed" & old_cat == 1
419:    scalar removed_verified_`samp' = r(N)
420:    count if status == "net_removed" & old_cat == 2
421:    scalar removed_unverifiable_`samp' = r(N)
422:    count if status == "net_removed" & old_cat == 3
423:    scalar removed_contradicted_`samp' = r(N)
424:
425:    * ---- CHANGED LINKS ----
426:    * Good
427:    count if status == "changed" & old_cat == 2 & new_cat == 1
428:    scalar chg_unv_ver_`samp' = r(N)
429:    count if status == "changed" & old_cat == 3 & new_cat == 1
430:    scalar chg_con_ver_`samp' = r(N)
431:
432:    * Bad
433:    count if status == "changed" & old_cat == 1 & new_cat == 2
434:    scalar chg_ver_unv_`samp' = r(N)
435:    count if status == "changed" & old_cat == 1 & new_cat == 3
436:    scalar chg_ver_con_`samp' = r(N)
437:    count if status == "changed" & old_cat == 2 & new_cat == 3
438:    scalar chg_unv_con_`samp' = r(N)
439:    count if status == "changed" & old_cat == 3 & new_cat == 3
440:    scalar chg_con_con_`samp' = r(N)
441:
442:    * Neutral
443:    count if status == "changed" & old_cat == 2 & new_cat == 2
444:    scalar chg_unv_unv_`samp' = r(N)
445:    count if status == "changed" & old_cat == 3 & new_cat == 2
446:    scalar chg_con_unv_`samp' = r(N)
447:
448:    di _newline "`mtag' (`samp') — status breakdown:"
449:    tab status
450:
451:} // end foreach samp
452:
453:
454:* ============================================================
455:* PART 4: LATEX TABLES
456:* ============================================================
457:
458:capture mkdir "`outdir'"
459:
460:foreach samp in full restr {
461:
462:    * ---- Format Panel A scalars ----
463:    foreach ver in old new {
464:        local rate_`ver'         : di %5.2f  (rate_`samp'_`ver'    * 100)
465:        local recall_`ver'       : di %5.2f  (recall_`samp'_`ver'  * 100)
466:        local mi_rate_`ver'      : di %5.2f  (mi_rate_`samp'_`ver' * 100)
467:        local verified_`ver'     : di %12.0fc verified_`samp'_`ver'
468:        local unverifiable_`ver' : di %12.0fc unverifiable_`samp'_`ver'
469:        local contradicted_`ver' : di %12.0fc contradicted_`samp'_`ver'
470:    }
471:
472:    * ---- Format Panel B scalars ----
473:    foreach cat in verified unverifiable contradicted {
474:        local n_a = added_`cat'_`samp'
475:        local p_a : di %4.1f (`n_a' / added_total_`samp' * 100)
476:        local f_a : di %9.0fc `n_a'
477:        local b_added_`cat' "`f_a' (`p_a'\%)"
478:
479:        local n_r = removed_`cat'_`samp'
480:        local p_r : di %4.1f (`n_r' / removed_total_`samp' * 100)
481:        local f_r : di %9.0fc `n_r'
482:        local b_removed_`cat' "`f_r' (`p_r'\%)"
483:    }
484:
485:    * ---- Set output file and caption ----
486:    * Filenames use a lowercased method tag so they stay consistent
487:    * across linkages; mlabel keeps its original case for display.
488:    local ftag = strlower("`mtag'")
489:    if "`samp'" == "full" {
490:        local outtex "`outdir'/linkage_table_`ftag'.tex"
491:        local caption "Linkage Quality, `mlabel' Links: Old vs.\ New Transcription, 1930--1940. Denominator is all men in the 1940 census."
492:    }
493:    if "`samp'" == "restr" {
494:        local outtex "`outdir'/linkage_table_`ftag'_restricted.tex"
495:        local caption "Linkage Quality, `mlabel' Links: Old vs.\ New Transcription, 1930--1940. Restricted to 1940 records where Ancestry and FamilySearch transcriptions disagree. Denominator is men in the 1940 census with discordant transcriptions."
496:    }
497:
498:    file open f using "`outtex'", write replace
499:
500:    file write f "\begin{table}[htbp]" _n
501:    file write f "\centering" _n
502:    file write f "\caption{`caption'}" _n
503:    file write f "\label{tab:linkage_quality_`mtag'_`samp'}" _n
504:    file write f "\begin{tabular}{lcc}" _n
505:    file write f "\toprule" _n
506:    file write f " & \multicolumn{2}{c}{`mlabel'} \\" _n
507:    file write f "\cmidrule(lr){2-3}" _n
508:    file write f " & Old & New \\" _n
509:
510:    * Panel A
511:    file write f "\midrule" _n
512:    file write f "\multicolumn{3}{l}{\textit{Panel A: Coverage and Link Quality}} \\" _n
513:    file write f "Match Rate (\%)       & `rate_old'         & `rate_new'         \\" _n
514:    file write f "MI Match Rate (\%)    & `mi_rate_old'      & `mi_rate_new'      \\" _n
515:    file write f "Verified Correct      & `verified_old'     & `verified_new'     \\" _n
516:    file write f "Unverifiable          & `unverifiable_old' & `unverifiable_new' \\" _n
517:    file write f "Directly Contradicted & `contradicted_old' & `contradicted_new' \\" _n
518:    file write f "Recall (\%)           & `recall_old'       & `recall_new'       \\" _n
519:
520:    * Panel B
521:    file write f "\midrule" _n
522:    file write f "\multicolumn{3}{l}{\textit{Panel B: Net New Links (New Transcription vs.\ Old)}} \\" _n
523:    file write f "\multicolumn{3}{l}{\textit{\quad Added}} \\" _n
524:    file write f "\quad (Good) Verified Correct      & \multicolumn{2}{c}{`b_added_verified'}     \\" _n
525:    file write f "\quad (Neutral) Unverifiable       & \multicolumn{2}{c}{`b_added_unverifiable'} \\" _n
526:    file write f "\quad (Bad) Directly Contradicted  & \multicolumn{2}{c}{`b_added_contradicted'} \\" _n
527:    file write f "\multicolumn{3}{l}{\textit{\quad Removed}} \\" _n
528:    file write f "\quad (Bad) Verified Correct       & \multicolumn{2}{c}{`b_removed_verified'}     \\" _n
529:    file write f "\quad (Neutral) Unverifiable       & \multicolumn{2}{c}{`b_removed_unverifiable'} \\" _n
530:    file write f "\quad (Good) Directly Contradicted & \multicolumn{2}{c}{`b_removed_contradicted'} \\" _n
531:
532:    file write f "\bottomrule" _n
533:    file write f "\end{tabular}" _n
534:    file write f "\end{table}" _n
535:
536:    file close f
537:    di _newline "LaTeX table written to: `outtex'"
538:}

