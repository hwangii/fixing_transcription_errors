F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:111:di as text _n "{hline 78}"
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:112:di as result "PER-BPL SPLITS"
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:113:di as text "{hline 78}"
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:114:
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:115:foreach tree in by_bpl by_bpl_new_transcription {
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:116:    capture confirm file "$ABEJW/data/`tree'/bpl_list.dta"
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:117:    if _rc {
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:118:        di as error "  MISS  $ABEJW/data/`tree'/bpl_list.dta"
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:119:        global NFAIL = $NFAIL + 1
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:120:        continue
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:121:    }
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:122:    quietly use "$ABEJW/data/`tree'/bpl_list.dta", clear
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:123:    quietly count
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:124:    local n_bpl = r(N)
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:125:    quietly levelsof bpl, local(bpls) clean
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:126:
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:127:    local missing 0
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:128:    foreach b of local bpls {
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:129:        foreach yr in 1930 1940 {
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:130:            capture confirm file "$ABEJW/data/`tree'/bpl_`b'/clean_names_`yr'.dta"
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:131:            if _rc local ++missing
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:132:        }
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:133:    }
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:134:    if `missing' == 0 {
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:135:        di as result "  OK    " as text %-28s "`tree'" ///
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:136:           "`n_bpl' bpl values, all split files present"
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:137:    }
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:138:    else {
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:139:        di as error "  MISS  `tree': `missing' of " ///
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:140:           %1.0f (2*`n_bpl') " split files absent"
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:141:        global NFAIL = $NFAIL + 1
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:142:    }
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:143:}
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:144:
