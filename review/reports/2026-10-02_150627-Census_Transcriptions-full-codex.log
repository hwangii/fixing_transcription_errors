F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:95:	* Panel A: linked records and linkage rate
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:96:	local N_o_`band' = ${n_`o'}
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:97:	local N_n_`band' = ${n_`n'}
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:98:	local N_d_`band' = `N_n_`band'' - `N_o_`band''
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:99:	local N_p_`band' = 100 * `N_d_`band'' / `N_o_`band''
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:100:
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:101:	local R_o_`band' = 100 * `N_o_`band'' / $denom
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:102:	local R_n_`band' = 100 * `N_n_`band'' / $denom
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:103:	local R_d_`band' = `R_n_`band'' - `R_o_`band''
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:104:
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:105:	* Panel B: validation sample, its share of links, and initial agreement
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:106:	local V_o_`band' = ${v_`o'}
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:107:	local V_n_`band' = ${v_`n'}
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:108:	local V_d_`band' = `V_n_`band'' - `V_o_`band''
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:109:	local V_p_`band' = 100 * `V_d_`band'' / `V_o_`band''
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:110:
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:111:	local S_o_`band' = 100 * `V_o_`band'' / `N_o_`band''
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:112:	local S_n_`band' = 100 * `V_n_`band'' / `N_n_`band''
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:113:	local S_d_`band' = `S_n_`band'' - `S_o_`band''
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:114:
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:115:	local A_o_`band' = 100 * ${a_`o'} / `V_o_`band''
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:116:	local A_n_`band' = 100 * ${a_`n'} / `V_n_`band''
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:117:	local A_d_`band' = `A_n_`band'' - `A_o_`band''
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:118:}
