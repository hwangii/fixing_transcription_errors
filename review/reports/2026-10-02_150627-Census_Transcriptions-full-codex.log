F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:20:global output_dir "$D_MORT/working"
F:/Deaglan/Census_Transcriptions/code/03_mortality/05_make_linkage_table.do:21:global bunmd_raw  "$D_MORT/raw/bunmd_v2/bunmd_v2.csv"
