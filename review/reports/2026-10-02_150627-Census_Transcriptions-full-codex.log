335:*==============================================================================
336:* MAIN
337:*==============================================================================
338:
339:foreach vint of local vintages {
340:
341:if "`vint'" == "old" {
342:    local bpldir  "$ABEJW/data/by_bpl"
343:    local namedir "$D_NAMES"
344:    local name30  "clean_names_1930_old.dta"
