498:*------------------------------------------------------------------
499:* COMPLETENESS CHECK
500:*------------------------------------------------------------------
501:* Never append a partial set silently -- a link file that is quietly missing
502:* three states looks exactly like a correct one downstream.
503:
504:* A birthplace is incomplete if its output is absent OR it failed in THIS run.
505:* The second half matters: with overwrite 1, a birthplace that fails still has
506:* its output file from an earlier run sitting on disk, so an existence test
507:* alone would happily append a stale result next to fresh ones and report a
508:* complete combined file. Found by deliberately failing one bpl in a test.
509:local missing ""
510:local n_missing 0
511:foreach b of local bpl_values {
512:    local isfail : list posof "`b'" in failed
513:    capture confirm file "`outdir'/abe_matches_bpl_`b'.dta"
514:    local absent = _rc
515:    if `absent' | `isfail' > 0 {
516:        local missing "`missing' `b'"
517:        local ++n_missing
518:        if `absent' == 0 & `isfail' > 0 {
519:            di as error "  bpl `b' failed this run; the file on disk is STALE"
520:        }
521:    }
522:}
523:
524:if `n_missing' > 0 {
525:    di as error _n "  `n_missing' of `n_bpl' birthplaces are missing or stale:`missing'"
526:    if !`allow_partial' {
527:        di as error "  NOT writing the combined file from a partial set."
528:        di as error "  Re-run to retry them (finished ones are skipped), or set"
529:        di as error "  allow_partial 1 if a partial file is genuinely wanted."
530:        continue
531:    }
532:    di as error "  allow_partial is 1 -- combining anyway. The output is PARTIAL."
533:}
534:
535:*------------------------------------------------------------------
536:* APPEND + ATTACH MIDDLE INITIALS
537:*------------------------------------------------------------------
538:
539:di as text _n "{hline 78}"
540:di as result "Appending `n_bpl' bpl file(s)"
541:di as text "{hline 78}"
542:
543:clear
544:local first 1
545:foreach b of local bpl_values {
546:    capture confirm file "`outdir'/abe_matches_bpl_`b'.dta"
547:    if _rc continue
