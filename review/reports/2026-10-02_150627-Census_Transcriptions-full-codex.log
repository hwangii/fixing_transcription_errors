556:quietly count
557:local n_combined = r(N)
558:di as text "  combined rows: " %14.0fc `n_combined'
559:
560:tempfile combined
561:quietly save `combined'
562:
563:if `add_mi' {
564:    * mi is not carried in the per-bpl files; merge it back by histid.
565:    * Target schema names these mi1930 (A side) and mi1940 (B side).
566:    di as text "  merging middle initials ..."
567:
568:    * Two-column loads: these files are 5-6 GB each, so never read them whole.
569:    * The id column is histid in the clean_names files but id in some of the
570:    * data/names/cleaned extracts, hence the fallback.
571:    tempfile mi30 mi40
572:    capture use histid mi using "`namedir'/`name30'", clear
573:    if _rc {
574:        use id mi using "`namedir'/`name30'", clear
575:        rename id histid
576:    }
577:    rename histid id_A
578:    rename mi mi1930
579:    quietly duplicates drop id_A, force
580:    quietly save `mi30'
581:
582:    capture use histid mi using "`namedir'/`name40'", clear
583:    if _rc {
584:        use id mi using "`namedir'/`name40'", clear
585:        rename id histid
586:    }
587:    rename histid id_B
588:    rename mi mi1940
589:    quietly duplicates drop id_B, force
590:    quietly save `mi40'
591:
592:    use `combined', clear
593:    quietly merge m:1 id_A using `mi30', keep(1 3) nogenerate
594:    quietly merge m:1 id_B using `mi40', keep(1 3) nogenerate
595:
596:    quietly count if !missing(mi1930)
597:    local n_mi30 = r(N)
598:    quietly count if !missing(mi1940)
599:    local n_mi40 = r(N)
600:    di as text "    mi1930 present: " %14.0fc `n_mi30' ///
601:       "   mi1940 present: " %14.0fc `n_mi40'
602:}
603:
604:* ---- match the target schema exactly ----
605:* The target link files carry ONLY these 9 variables. abematch's working
606:* columns (unique_match*, unique_file*, timediff_*, age, the match variables)
607:* and bpl are kept in the per-bpl intermediates for diagnostics, but dropped
608:* here so the final artifact is schema-identical to the originals.
609:local schema id_B f_name_B l_name_B id_A f_name_A l_name_A fiveyr_band
