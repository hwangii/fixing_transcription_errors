/*------------------------------------------------------------------------------
Why does the full-count ABE reconstruction fall ~1,600 pairs short?

run_abe_match.do reproduced Massachusetts EXACTLY (488,439 pairs, identical
fields). On the full count it lands 1,615 pairs short for the old vintage and
1,021 short for the new -- 0.0095% and 0.0056%. Small, but Massachusetts was
exact, so this is not general noise and should be explained rather than
tolerated.

The first question is directional:

  * If the reconstruction is a strict SUBSET of the original, the rule is the
    same and something is dropping a few pairs at a boundary.
  * If it also contains pairs the original lacks, the two runs are resolving
    something differently -- ties, ordering, or a parameter that only bites on
    birthplaces Massachusetts does not exercise.

Those imply very different fixes, so establish which before theorising.

Then locate the missing pairs by birthplace. Concentrated in a few birthplaces
points at a specific failure; spread thinly across many points at tie-breaking.

Reads only. Writes nothing except a small summary file.
------------------------------------------------------------------------------*/

drop _all
clear all
set more off

if "$ROOT" == "" global ROOT "F:/Deaglan/Census_Transcriptions"
do "$ROOT/code/shared/paths.do"

local vintage "old"

if "`vintage'" == "old" {
    local bpldir "$ABEJW/data/by_bpl"
    local tag    "ans_cleaned"
}
else {
    local bpldir "$ABEJW/data/by_bpl_new_transcription"
    local tag    "true_cleaned"
}

local original "$D_LINKS/link1930_1940_`tag'_noraceblock0.dta"
local recon    "$D_LINKS/link1930_1940_`tag'_noraceblock0_RECONSTRUCTED.dta"

foreach f in "`original'" "`recon'" {
    capture confirm file "`f'"
    if _rc {
        di as error "missing: `f'"
        exit 601
    }
}

di as text _n "{hline 78}"
di as result "ABE shortfall diagnosis  --  vintage `vintage'"
di as text "{hline 78}"

*==============================================================================
* 1. Direction: subset, superset, or both?
*==============================================================================

use id_A id_B using "`original'", clear
quietly count
local n_orig = r(N)
tempfile orig
quietly save `orig'

use id_A id_B using "`recon'", clear
quietly count
local n_recon = r(N)

quietly merge 1:1 id_A id_B using `orig', generate(_m)

quietly count if _m == 3
local n_both = r(N)
quietly count if _m == 1
local n_only_recon = r(N)
quietly count if _m == 2
local n_only_orig = r(N)

di as text _n "{hline 78}"
di as result "DIRECTION"
di as text "{hline 78}"
di as text "  original pairs        : " %14.0fc `n_orig'
di as text "  reconstruction pairs  : " %14.0fc `n_recon'
di as text "  in both               : " %14.0fc `n_both'
di as text "  reconstruction ONLY   : " %14.0fc `n_only_recon'
di as text "  original ONLY         : " %14.0fc `n_only_orig'

if `n_only_recon' == 0 {
    di as result _n "  => the reconstruction is a strict SUBSET of the original."
    di as text    "     Same rule; a few pairs are being dropped somewhere."
}
else {
    di as error _n "  => NOT a subset: the reconstruction contains " ///
       %12.0fc `n_only_recon' " pairs the original lacks."
    di as text    "     The two runs resolve something differently."
}

* keep the disagreeing pairs for step 2
quietly keep if _m != 3
rename _m _side
tempfile diff
quietly save `diff'

*==============================================================================
* 2. Where are they? Build histid -> bpl from the matcher's own inputs.
*==============================================================================
* The link files carry no bpl column, so recover it from the per-birthplace
* input files -- which is exactly the partition the matcher used.

use "`bpldir'/bpl_list.dta", clear
quietly levelsof bpl, local(bpls) clean

tempfile map
local first 1
foreach b of local bpls {
    quietly use histid using "`bpldir'/bpl_`b'/clean_names_1930.dta", clear
    quietly generate int bpl = `b'
    if `first' {
        quietly save `map', replace
        local first 0
    }
    else {
        quietly append using `map'
        quietly save `map', replace
    }
}
quietly use `map', clear
quietly count
local n_map = r(N)
quietly duplicates drop histid, force
quietly save `map', replace
di as text _n "  A-side id -> bpl map: " %14.0fc `n_map' " ids"

use `diff', clear
rename id_A histid
quietly merge m:1 histid using `map', keep(1 3) nogenerate

di as text _n "{hline 78}"
di as result "MISSING PAIRS BY BIRTHPLACE (original only)"
di as text "{hline 78}"

preserve
    quietly keep if _side == 2
    quietly count
    local n_miss = r(N)
    quietly count if missing(bpl)
    local n_nobpl = r(N)
    di as text "  missing pairs         : " %14.0fc `n_miss'
    di as text "  whose A-side id is NOT in any bpl input file : " %10.0fc `n_nobpl'
    if `n_nobpl' > 0 {
        di as error "  ^ those A-side records are absent from the matcher's input"
        di as error "    entirely, so no parameter change could recover them."
    }

    quietly drop if missing(bpl)
    if _N > 0 {
        contract bpl, freq(n_missing)
        gsort -n_missing
        di as text _n "  top birthplaces by missing pairs:"
        list bpl n_missing in 1/`=min(20,_N)', noobs clean
        quietly count
        di as text _n "  birthplaces affected : " %6.0f r(N)
    }
restore

di as text _n "{hline 78}"
di as result "DONE"
di as text "{hline 78}"
/*------------------------------------------------------------------------------
Follow-up: WHY are those 1,615 A-side records absent from the matcher's input?

Step 1 (diagnose_abe_shortfall.do) established:
  - the reconstruction is a strict SUBSET of the original (0 extra pairs)
  - all 1,615 missing pairs have A-side ids absent from every by_bpl input file

So the matching rule is right and the INPUT PARTITION differs. The by_bpl split
holds 62,048,998 of the 62,079,010 records in clean_names_1930_old -- a gap of
30,012 dropped by run_full_census_prep.do, which:

    keep if sex == 1
    drop if missing(bpl) | missing(race) | first_initial == "" | last_initial == ""
    ... then bpl_list keeps only birthplaces present in BOTH years

This script asks which of those rules excluded the 1,615, by looking them up in
clean_names_1930_old and reporting the values of the filtered-on variables.

Reads only.
------------------------------------------------------------------------------*/

drop _all
clear all
set more off

if "$ROOT" == "" global ROOT "F:/Deaglan/Census_Transcriptions"
do "$ROOT/code/shared/paths.do"

local tag "ans_cleaned"
local original "$D_LINKS/link1930_1940_`tag'_noraceblock0.dta"
local recon    "$D_LINKS/link1930_1940_`tag'_noraceblock0_RECONSTRUCTED.dta"

* ---- recover the missing pairs' A-side ids ----
use id_A id_B using "`recon'", clear
tempfile r
quietly save `r'

use id_A id_B using "`original'", clear
quietly merge 1:1 id_A id_B using `r', keep(1) nogenerate
quietly count
local n_miss = r(N)
di as text _n "  missing pairs: " %10.0fc `n_miss'

keep id_A
quietly duplicates drop id_A, force
quietly count
local n_ids = r(N)
di as text "  distinct A-side ids: " %10.0fc `n_ids'
rename id_A histid
tempfile missids
quietly save `missids'

* ---- look them up in the FULL cleaned-name file ----
use histid sex race bpl f_name l_name using "$D_NAMES/clean_names_1930_old.dta", clear
quietly count
local n_clean = r(N)
quietly merge 1:m histid using `missids', keep(3) nogenerate
quietly count
local n_found = r(N)

di as text _n "{hline 78}"
di as result "ARE THE MISSING A-SIDE RECORDS IN clean_names_1930_old?"
di as text "{hline 78}"
di as text "  clean_names_1930_old rows : " %14.0fc `n_clean'
di as text "  of the " %6.0f `n_ids' " missing ids, found here : " %10.0fc `n_found'

if `n_found' == 0 {
    di as error _n "  None are in the cleaned-name file either -- the originals were"
    di as error "  built from a different/earlier input than this package holds."
    exit 0
}

* ---- which prep filter would have excluded them? ----
quietly generate byte no_race  = missing(race)
quietly generate byte no_bpl   = missing(bpl)
quietly generate byte no_fi    = (substr(f_name, 1, 1) == "")
quietly generate byte no_li    = (substr(l_name, 1, 1) == "")
quietly generate byte not_male = (sex != 1)

di as text _n "  Which prep filter excludes them (a record can trip more than one):"
foreach v in not_male no_bpl no_race no_fi no_li {
    quietly count if `v' == 1
    di as text "    " %-10s "`v'" " : " %8.0fc r(N)
}

quietly count if !not_male & !no_bpl & !no_race & !no_fi & !no_li
local n_clean_pass = r(N)
di as text _n "  pass EVERY prep filter yet are still absent from by_bpl : " ///
   %8.0fc `n_clean_pass'

if `n_clean_pass' > 0 {
    di as text "  => these were dropped by the bpl_list step, which keeps only"
    di as text "     birthplaces present in BOTH census years."
    preserve
        quietly keep if !not_male & !no_bpl & !no_race & !no_fi & !no_li
        contract bpl, freq(n)
        gsort -n
        di as text _n "  their birthplaces:"
        list bpl n in 1/`=min(15,_N)', noobs clean
    restore
}

di as text _n "{hline 78}"
di as result "DONE"
di as text "{hline 78}"
/*------------------------------------------------------------------------------
Final step: what ARE the 1,615 pairs the reconstruction does not produce?

Step 1: the reconstruction is a strict subset of the original (0 extra pairs);
        all missing pairs' A-side ids are absent from the matcher's input.
Step 2: all 1,615 of those A-side records ARE in clean_names_1930_old, are male,
        and have bpl and race -- but 791 have a blank FIRST name and 947 a blank
        LAST name. run_full_census_prep.do drops them because a record with no
        initial cannot be blocked.

ABE matches on EXACT cleaned names. So if a pair's 1930 first name is blank, its
1940 first name must be blank too, or they could not have matched. This script
checks that directly in the original link file rather than inferring it, and
reports what fraction of the missing pairs are joined on an empty name field.

That decides how to read the shortfall: if these are blank-on-blank joins, the
reconstruction is not missing real links -- it is declining to make spurious
ones, and is arguably the better output.

Reads only.
------------------------------------------------------------------------------*/

drop _all
clear all
set more off

if "$ROOT" == "" global ROOT "F:/Deaglan/Census_Transcriptions"
do "$ROOT/code/shared/paths.do"

foreach tag in ans_cleaned true_cleaned {

di as text _n(2) "{hline 78}"
di as result "VINTAGE: `tag'"
di as text "{hline 78}"

local original "$D_LINKS/link1930_1940_`tag'_noraceblock0.dta"
local recon    "$D_LINKS/link1930_1940_`tag'_noraceblock0_RECONSTRUCTED.dta"

use id_A id_B using "`recon'", clear
tempfile r
quietly save `r'

* the missing pairs, WITH their name fields as the original recorded them
use id_A id_B f_name_A l_name_A f_name_B l_name_B fiveyr_band using "`original'", clear
quietly merge 1:1 id_A id_B using `r', keep(1) nogenerate
quietly count
local n = r(N)

di as text _n "{hline 78}"
di as result "WHAT ARE THE " %6.0f `n' " MISSING PAIRS?"
di as text "{hline 78}"

quietly generate byte blank_f = (trim(f_name_A) == "" | trim(f_name_B) == "")
quietly generate byte blank_l = (trim(l_name_A) == "" | trim(l_name_B) == "")
quietly generate byte blank_any = (blank_f | blank_l)

foreach v in blank_f blank_l blank_any {
    quietly count if `v' == 1
    local c = r(N)
    di as text "  " %-34s "`v'" " : " %8.0fc `c' "  (" %5.1f (100*`c'/`n') "%)"
}

* both sides blank on the same field -- the join could only have been blank-on-blank
quietly count if trim(f_name_A) == "" & trim(f_name_B) == ""
local bf = r(N)
quietly count if trim(l_name_A) == "" & trim(l_name_B) == ""
local bl = r(N)
di as text _n "  first name blank on BOTH sides   : " %8.0fc `bf'
di as text "  last  name blank on BOTH sides   : " %8.0fc `bl'

quietly count if fiveyr_band == 1
di as text _n "  of these, fiveyr_band == 1       : " %8.0fc r(N) ///
   "   (these would enter the table)"

di as text _n "  a sample:"
list f_name_A l_name_A f_name_B l_name_B fiveyr_band in 1/`=min(8,_N)', noobs clean

}   // end vintage loop

di as text _n "{hline 78}"
di as result "DONE"
di as text "{hline 78}"

codex
The current scripts count linked pairs, and the HLINK deduplication cited in the documentation occurs after the match-rate calculation. I also found that the numerator does not explicitly use the denominator’s age-eligible sample; I’m checking the logs and upstream filters to establish the consequences.

