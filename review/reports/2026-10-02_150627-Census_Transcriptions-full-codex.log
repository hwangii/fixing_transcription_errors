376:        di as error "  requested: `bpl_subset'"
377:        exit 111
378:    }
379:}
380:sort bpl
381:quietly levelsof bpl, local(bpl_values) clean
382:local n_bpl : word count `bpl_values'
383:
384:* size lookup, and the total records this run must chew through
385:quietly summarize n_total, meanonly
386:local rows_total = r(sum)
387:forvalues i = 1/`=_N' {
388:    local bb = bpl[`i']
389:    local sz_`bb' = n_total[`i']
390:}
391:
392:di as text _n "{hline 78}"
393:di as result "ABE matching  --  vintage: `vint'  --  `n_bpl' bpl value(s)"
394:di as text "{hline 78}"
395:di as text "  match vars : f_name_cleaned l_name_cleaned"
396:di as text "  nysiis     : `use_nysiis'"
397:di as text "  resume     : " cond(`overwrite', "no (overwrite)", "yes (skip existing)")
398:di as text "  on error   : " cond(`stop_on_error', "abort", "record and continue")
399:di as text "  input      : `bpldir'"
400:di as text "  output     : `outdir'"
401:di as text "  records    : " %14.0fc `rows_total'
402:
403:*------------------------------------------------------------------
404:* MATCH, ONE BPL AT A TIME
405:*------------------------------------------------------------------
406:* bpl is a blocking variable, so matching never crosses a bpl boundary and
407:* each can be processed independently with identical results.
408:
409:local idx        0
410:local n_ok       0
411:local n_skip     0
412:local n_fail     0
413:local failed     ""
414:local rows_done  0
415:local secs_done  0
416:
417:timer clear 2
418:timer on 2
419:
420:foreach b of local bpl_values {
421:
422:    local ++idx
423:    local src "`bpldir'/bpl_`b'"
424:    local out "`outdir'/abe_matches_bpl_`b'.dta"
425:    local sz  = `sz_`b''
426:
427:    * ---- resume ----
428:    if !`overwrite' {
429:        capture confirm file "`out'"
430:        if _rc == 0 {
431:            local ++n_skip
432:            local rows_done = `rows_done' + `sz'
433:            di as text "[`idx'/`n_bpl'] bpl `b' -- exists, skipping"
434:            continue
435:        }
436:    }
437:
438:    di as text _n "{hline 78}"
439:    di as result "[`idx'/`n_bpl'] bpl `b'" as text "   (" %12.0fc `sz' " records)"
440:    di as text "{hline 78}"
441:
442:    timer clear 1
443:    timer on 1
444:    capture noisily abe_one_bpl, bpl(`b') srcdir("`src'") outfile("`out'") ///
445:        nysiis(`use_nysiis')
446:    local rc = _rc
447:    timer off 1
448:    quietly timer list 1
449:    local secs = r(t1)
450:
451:    if `rc' {
452:        local ++n_fail
453:        local failed "`failed' `b'"
454:        di as error "  FAILED on bpl `b' (rc = `rc') after " %6.1f `secs' "s"
455:        if `stop_on_error' {
456:            di as error "  stop_on_error is 1 -- aborting"
457:            exit `rc'
458:        }
459:    }
460:    else {
461:        local ++n_ok
462:        local secs_done = `secs_done' + `secs'
463:        local pct = cond($ABE_NRAW > 0, 100 * $ABE_NBAND / $ABE_NRAW, 0)
464:        di as text "  input rows : " %12.0fc $ABE_N1930 " (1930)  " ///
465:                                     %12.0fc $ABE_N1940 " (1940)"
466:        di as text "  matches    : " %12.0fc $ABE_NRAW ///
467:           "   fiveyr_band==1: " %12.0fc $ABE_NBAND "  (" %5.1f `pct' "%)"
468:        di as text "  time       : " %8.1f `secs' "s"
469:    }
470:
471:    * ---- records-weighted ETA ----
472:    * Birthplace count is a poor progress measure here: the largest bpl holds
473:    * two million times the records of the smallest. Weight by records.
474:    local rows_done = `rows_done' + `sz'
475:    if `secs_done' > 0 & `rows_done' > 0 & `rows_done' < `rows_total' {
476:        local rate = `secs_done' / `rows_done'
477:        local eta  = `rate' * (`rows_total' - `rows_done')
478:        di as text "  progress   : " %5.1f (100 * `rows_done' / `rows_total') ///
479:           "% of records   ETA " %6.2f (`eta'/3600) " h"
480:    }
481:}
482:
483:timer off 2
484:quietly timer list 2
485:local secs_match = r(t2)
486:
487:di as text _n "{hline 78}"
488:di as result "MATCHING DONE  --  vintage `vint'"
489:di as text "{hline 78}"
490:di as text "  matched    : `n_ok'"
491:di as text "  skipped    : `n_skip'   (output already existed)"
492:di as text "  failed     : `n_fail'"
493:di as text "  wall time  : " %6.2f (`secs_match'/3600) " h"
494:if `n_fail' > 0 {
