97:* ============================================================
98:* HELPER: normalise variable names in a names file
99:* ============================================================
100:* The appended files in data/transcriptions/appended do not use the same variable
101:* names as the older clean_names extracts: the histid is called
102:* id, and the middle initial can be mi_true_cleaned or
103:* mi_ans_cleaned. This renames whichever variant is present to
104:* the canonical histid and mi, so everything downstream can
105:* assume a single schema. Call it straight after -use-. It is a
106:* no-op on files that already use the canonical names.
107:*
108:* Optional arguments override the candidate lists, in preference
109:* order:
110:*     normalize_names, idvars(histid id) mivars(mi mi_true_cleaned)
111:
112:capture program drop normalize_names
113:program define normalize_names
114:    syntax [, IDVars(string) MIVars(string)]
115:
116:    if "`idvars'" == "" local idvars "histid id"
117:    if "`mivars'" == "" local mivars "mi mi_true_cleaned mi_ans_cleaned"
118:
119:    * Matching is done against the exact variable list via posof,
120:    * not with -confirm variable-, because confirm accepts
121:    * abbreviations: when mi_true_cleaned is present and mi is
122:    * not, confirm variable mi succeeds on the abbreviation and
123:    * the rename below would be skipped.
124:    quietly ds
125:    local have `r(varlist)'
126:
127:    * ---- histid ----
128:    local p : list posof "histid" in have
129:    if `p' == 0 {
130:        local got ""
131:        foreach v of local idvars {
132:            if "`got'" == "" {
133:                local q : list posof "`v'" in have
134:                if `q' > 0 local got "`v'"
135:            }
136:        }
137:        if "`got'" == "" {
138:            di as error "normalize_names: no histid variable found"
139:            di as error "  looked for: `idvars'"
140:            di as error "  data has:   `have'"
141:            exit 111
142:        }
143:        capture confirm string variable `got'
144:        if _rc {
145:            local t : type `got'
146:            di as error "normalize_names: `got' is `t', not a string"
147:            exit 109
148:        }
149:        rename `got' histid
150:        di as text "  normalize_names: `got' -> histid"
151:    }
152:
153:    * ---- mi ----
154:    local p : list posof "mi" in have
155:    if `p' == 0 {
156:        local got ""
157:        foreach v of local mivars {
158:            if "`got'" == "" {
159:                local q : list posof "`v'" in have
160:                if `q' > 0 local got "`v'"
161:            }
162:        }
163:        if "`got'" == "" {
164:            di as error "normalize_names: no middle-initial variable found"
165:            di as error "  looked for: `mivars'"
166:            di as error "  data has:   `have'"
167:            exit 111
168:        }
169:        rename `got' mi
170:        di as text "  normalize_names: `got' -> mi"
171:    }
172:end
