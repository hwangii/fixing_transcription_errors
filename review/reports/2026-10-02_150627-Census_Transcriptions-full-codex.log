F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:44:di as result "DIRECTORIES"
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:45:di as text "{hline 78}"
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:46:
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:47:foreach g in ROOT CODE C_ABEJW C_HLINK C_MORT DATA D_CENSUS D_NAMES     ///
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:48:             D_FLAGS D_TRANSCRIPT D_APPENDED D_LINKS D_LINKS_RAW       ///
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:49:             D_TRUTH D_MORT OUT OUT_TABLES OUT_LOGS ABEJW ABE_SRC {
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:50:    local p "${`g'}"
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:51:    * a directory is confirmed by the presence of its own path as a dir:
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:52:    * -confirm file- fails on directories, so test with a wildcard listing
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:53:    local ok = 0
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:54:    mata: st_local("ok", strofreal(direxists(st_local("p"))))
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:55:    if `ok' == 1 {
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:56:        di as text "  " %-14s "`g'" as result " OK   " as text "`p'"
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:57:    }
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:58:    else {
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:59:        di as text "  " %-14s "`g'" as error " MISS " as text "`p'"
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:60:        global NFAIL = $NFAIL + 1
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:61:    }
F:/Deaglan/Census_Transcriptions/code/shared/verify_paths.do:62:}
