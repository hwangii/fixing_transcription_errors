205:            count if mi1930 == mi1940
206:            scalar mi_match_`samp'_`combo' = r(N)
207:            scalar mi_rate_`samp'_`combo'  = mi_match_`samp'_`combo' / mi_denom_`samp'_`combo'
208:        restore
209:
210:        di "`combo':" ///
211:           "  Verified=" verified_`samp'_`combo' ///
212:           "  Unverifiable=" unverifiable_`samp'_`combo' ///
213:           "  Contradicted=" contradicted_`samp'_`combo' ///
214:           "  Recall=" %5.3f recall_`samp'_`combo' ///
215:           "  MI match rate=" %5.3f mi_rate_`samp'_`combo'
216:    }
217:
218:
219:    * ============================================================
220:    * PART 3: NEW vs OLD — net added, net removed, changed links
221:    * ============================================================
222:
223:    di _newline "===== NEW vs OLD TRANSCRIPTION: PAIR CHANGES ====="
224:
225:    foreach method in "jw" "abe" {
226:
227:        * ---- Load new transcription pairs ----
228:        use ``method'_new', clear
229:        if "`method'" == "abe" {
230:            keep if fiveyr_band == 1
231:            rename id_A histid1930
232:            rename id_B histid1940
233:        }
234:        else {
235:            rename Ahistid histid1930
236:            rename Bhistid histid1940
237:        }
238:        keep histid1930 histid1940
239:        if "`samp'" == "restr" {
240:            rename histid1940 histid
241:            merge m:1 histid using `restr1940', keep(3) nogenerate
242:            rename histid histid1940
243:        }
244:        duplicates drop histid1930, force
245:        rename histid1940 histid1940_new
246:        tempfile new_`method'_`samp'
247:        save `new_`method'_`samp''
248:
249:        * ---- Load old transcription pairs ----
250:        use ``method'_old', clear
251:        if "`method'" == "abe" {
252:            keep if fiveyr_band == 1
253:            rename id_A histid1930
254:            rename id_B histid1940
255:        }
256:        else {
257:            rename Ahistid histid1930
258:            rename Bhistid histid1940
259:        }
260:        keep histid1930 histid1940
261:        if "`samp'" == "restr" {
262:            rename histid1940 histid
263:            merge m:1 histid using `restr1940', keep(3) nogenerate
264:            rename histid histid1940
265:        }
266:        duplicates drop histid1930, force
267:        rename histid1940 histid1940_old
268:
269:        * ---- Merge on histid1930 ----
270:        merge 1:1 histid1930 using `new_`method'_`samp'', gen(id_merge)
271:
272:        gen status = ""
273:        replace status = "net_removed" if id_merge == 1
274:        replace status = "net_added"   if id_merge == 2
275:        replace status = "unchanged"   if id_merge == 3 & histid1940_old == histid1940_new
276:        replace status = "changed"     if id_merge == 3 & histid1940_old != histid1940_new
277:
278:        * ---- Merge with true links (1940-centric) ----
279:        * For net_added/unchanged/changed: classify using histid1940_new
280:        * For net_removed: classify using histid1940_old
281:        * We need to merge twice — once per 1940 ID column
282:
283:        * Classify new link (net_added, changed)
284:        gen new_cat = .
285:        rename histid1940_new histid1940
286:        merge m:1 histid1940 using `true_by1940', keep(1 3) gen(merge_new)
287:        replace new_cat = 2 if inlist(status,"net_added","changed") & merge_new == 1
288:        replace new_cat = 1 if inlist(status,"net_added","changed") & merge_new == 3 & histid1930 == true_histid1930
289:        replace new_cat = 3 if inlist(status,"net_added","changed") & merge_new == 3 & histid1930 != true_histid1930
290:        rename histid1940 histid1940_new
291:        drop true_histid1930 merge_new
292:
293:        * Classify old link (net_removed, changed)
294:        gen old_cat = .
295:        rename histid1940_old histid1940
296:        merge m:1 histid1940 using `true_by1940', keep(1 3) gen(merge_old)
297:        replace old_cat = 2 if inlist(status,"net_removed","changed") & merge_old == 1
298:        replace old_cat = 1 if inlist(status,"net_removed","changed") & merge_old == 3 & histid1930 == true_histid1930
299:        replace old_cat = 3 if inlist(status,"net_removed","changed") & merge_old == 3 & histid1930 != true_histid1930
300:        rename histid1940 histid1940_old
301:        drop true_histid1930 merge_old
302:
303:        * ---- NET ADDED ----
304:        count if status == "net_added"
305:        scalar added_total_`samp'_`method' = r(N)
306:        count if status == "net_added" & new_cat == 1
307:        scalar added_verified_`samp'_`method' = r(N)
308:        count if status == "net_added" & new_cat == 2
309:        scalar added_unverifiable_`samp'_`method' = r(N)
310:        count if status == "net_added" & new_cat == 3
311:        scalar added_contradicted_`samp'_`method' = r(N)
312:
313:        * ---- NET REMOVED ----
314:        count if status == "net_removed"
315:        scalar removed_total_`samp'_`method' = r(N)
316:        count if status == "net_removed" & old_cat == 1
317:        scalar removed_verified_`samp'_`method' = r(N)
318:        count if status == "net_removed" & old_cat == 2
319:        scalar removed_unverifiable_`samp'_`method' = r(N)
320:        count if status == "net_removed" & old_cat == 3
321:        scalar removed_contradicted_`samp'_`method' = r(N)
322:
323:        * ---- CHANGED LINKS ----
324:        * Good
325:        count if status == "changed" & old_cat == 2 & new_cat == 1
326:        scalar chg_unv_ver_`samp'_`method' = r(N)
327:        count if status == "changed" & old_cat == 3 & new_cat == 1
328:        scalar chg_con_ver_`samp'_`method' = r(N)
329:
330:        * Bad
331:        count if status == "changed" & old_cat == 1 & new_cat == 2
332:        scalar chg_ver_unv_`samp'_`method' = r(N)
333:        count if status == "changed" & old_cat == 1 & new_cat == 3
334:        scalar chg_ver_con_`samp'_`method' = r(N)
335:        count if status == "changed" & old_cat == 2 & new_cat == 3
336:        scalar chg_unv_con_`samp'_`method' = r(N)
337:        count if status == "changed" & old_cat == 3 & new_cat == 3
338:        scalar chg_con_con_`samp'_`method' = r(N)
339:
340:        * Neutral
341:        count if status == "changed" & old_cat == 2 & new_cat == 2
342:        scalar chg_unv_unv_`samp'_`method' = r(N)
343:        count if status == "changed" & old_cat == 3 & new_cat == 2
344:        scalar chg_con_unv_`samp'_`method' = r(N)
345:
346:        di _newline "`method' (`samp') — status breakdown:"
347:        tab status
348:    }
349:
350:} // end foreach samp
351:
352:
353:* ============================================================
354:* PART 4: LATEX TABLES
355:* ============================================================
356:
357:capture mkdir "$OUT_TABLES"
358:
359:foreach samp in full restr {
360:
361:    * ---- Format Panel A scalars ----
362:    foreach combo in jw_old jw_new abe_old abe_new {
363:        local rate_`combo'         : di %5.2f  (rate_`samp'_`combo'    * 100)
364:        local recall_`combo'       : di %5.2f  (recall_`samp'_`combo'  * 100)
365:        local mi_rate_`combo'      : di %5.2f  (mi_rate_`samp'_`combo' * 100)
366:        local verified_`combo'     : di %12.0fc verified_`samp'_`combo'
367:        local unverifiable_`combo' : di %12.0fc unverifiable_`samp'_`combo'
368:        local contradicted_`combo' : di %12.0fc contradicted_`samp'_`combo'
369:    }
370:
371:    * ---- Format Panel B scalars ----
372:    foreach method in jw abe {
373:
374:        foreach cat in verified unverifiable contradicted {
375:            local n_a = added_`cat'_`samp'_`method'
376:            local p_a : di %4.1f (`n_a' / added_total_`samp'_`method' * 100)
377:            local f_a : di %9.0fc `n_a'
378:            local b_added_`cat'_`method' "`f_a' (`p_a'\%)"
379:
380:            local n_r = removed_`cat'_`samp'_`method'
381:            local p_r : di %4.1f (`n_r' / removed_total_`samp'_`method' * 100)
382:            local f_r : di %9.0fc `n_r'
383:            local b_removed_`cat'_`method' "`f_r' (`p_r'\%)"
384:        }
385:    }
386:
387:    * ---- Set output file and caption ----
388:    if "`samp'" == "full" {
389:        local outtex "$OUT_TABLES/linkage_table_abe_jw.tex"
390:        local caption "Linkage Quality: Old vs.\ New Transcription, 1930--1940. Denominator is all men in the 1940 census."
391:    }
392:    if "`samp'" == "restr" {
393:        local outtex "$OUT_TABLES/linkage_table_abe_jw_restricted.tex"
394:        local caption "Linkage Quality: Old vs.\ New Transcription, 1930--1940. Restricted to 1940 records where Ancestry and FamilySearch transcriptions disagree. Denominator is men in the 1940 census with discordant transcriptions."
395:    }
396:
397:    file open f using "`outtex'", write replace
398:
399:    file write f "\begin{table}[htbp]" _n
400:    file write f "\centering" _n
401:    file write f "\caption{`caption'}" _n
402:    file write f "\label{tab:linkage_quality_`samp'}" _n
403:    file write f "\begin{tabular}{lcccc}" _n
404:    file write f "\toprule" _n
405:    file write f " & \multicolumn{2}{c}{Jaro-Winkler} & \multicolumn{2}{c}{ABE} \\" _n
406:    file write f "\cmidrule(lr){2-3}\cmidrule(lr){4-5}" _n
407:    file write f " & Old & New & Old & New \\" _n
408:
409:    * Panel A
410:    file write f "\midrule" _n
411:    file write f "\multicolumn{5}{l}{\textit{Panel A: Coverage and Link Quality}} \\" _n
412:    file write f "Match Rate (\%)       & `rate_jw_old'         & `rate_jw_new'         & `rate_abe_old'         & `rate_abe_new'         \\" _n
413:    file write f "MI Match Rate (\%)    & `mi_rate_jw_old'      & `mi_rate_jw_new'      & `mi_rate_abe_old'      & `mi_rate_abe_new'      \\" _n
414:    file write f "Verified Correct      & `verified_jw_old'     & `verified_jw_new'     & `verified_abe_old'     & `verified_abe_new'     \\" _n
415:    file write f "Unverifiable          & `unverifiable_jw_old' & `unverifiable_jw_new' & `unverifiable_abe_old' & `unverifiable_abe_new' \\" _n
416:    file write f "Directly Contradicted & `contradicted_jw_old' & `contradicted_jw_new' & `contradicted_abe_old' & `contradicted_abe_new' \\" _n
417:    file write f "Recall (\%)           & `recall_jw_old'       & `recall_jw_new'       & `recall_abe_old'       & `recall_abe_new'       \\" _n
418:
419:    * Panel B
420:    file write f "\midrule" _n
421:    file write f "\multicolumn{5}{l}{\textit{Panel B: Net New Links (New Transcription vs.\ Old)}} \\" _n
422:    file write f "\multicolumn{5}{l}{\textit{\quad Added}} \\" _n
423:    file write f "\quad (Good) Verified Correct      & \multicolumn{2}{c}{`b_added_verified_jw'}     & \multicolumn{2}{c}{`b_added_verified_abe'}     \\" _n
424:    file write f "\quad (Neutral) Unverifiable       & \multicolumn{2}{c}{`b_added_unverifiable_jw'} & \multicolumn{2}{c}{`b_added_unverifiable_abe'} \\" _n
425:    file write f "\quad (Bad) Directly Contradicted  & \multicolumn{2}{c}{`b_added_contradicted_jw'} & \multicolumn{2}{c}{`b_added_contradicted_abe'} \\" _n
426:    file write f "\multicolumn{5}{l}{\textit{\quad Removed}} \\" _n
427:    file write f "\quad (Bad) Verified Correct       & \multicolumn{2}{c}{`b_removed_verified_jw'}     & \multicolumn{2}{c}{`b_removed_verified_abe'}     \\" _n
428:    file write f "\quad (Neutral) Unverifiable       & \multicolumn{2}{c}{`b_removed_unverifiable_jw'} & \multicolumn{2}{c}{`b_removed_unverifiable_abe'} \\" _n
429:    file write f "\quad (Good) Directly Contradicted & \multicolumn{2}{c}{`b_removed_contradicted_jw'} & \multicolumn{2}{c}{`b_removed_contradicted_abe'} \\" _n
430:
431:    file write f "\bottomrule" _n
432:    file write f "\end{tabular}" _n
433:    file write f "\end{table}" _n
434:
435:    file close f
436:    di _newline "LaTeX table written to: `outtex'"
437:}

